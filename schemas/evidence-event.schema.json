{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "type":  "object",
    "required":  [
                     "event_id",
                     "session_id",
                     "module_id",
                     "event_type",
                     "timestamp_local",
                     "timestamp_utc",
                     "actor",
                     "action",
                     "result",
                     "sanitized_details",
                     "evidence_references"
                 ],
    "additionalProperties":  true,
    "status_values":  [
                          "NOT_STARTED",
                          "PREFLIGHT",
                          "IN_PROGRESS",
                          "VALIDATING",
                          "GREEN",
                          "YELLOW",
                          "BLUE",
                          "RED",
                          "BLOCKED",
                          "STOPPED",
                          "COMPLETE"
                      ],
    "legacy_status_aliases":  {
                                  "WAITING_FOR_EXTERNAL_DEPENDENCY":  "BLUE"
                              }
}
