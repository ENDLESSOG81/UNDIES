{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "type":  "object",
    "required":  [
                     "session_id",
                     "project_name",
                     "project_code",
                     "project_version",
                     "workspace",
                     "start_time_local",
                     "start_time_utc",
                     "current_module",
                     "completed_modules",
                     "pending_modules",
                     "resume_point",
                     "final_status"
                 ],
    "additionalProperties":  true,
    "status_values":  [
                          "NOT_STARTED",
                          "PREFLIGHT",
                          "IN_PROGRESS",
                          "VALIDATING",
                          "GREEN",
                          "YELLOW",
                          "BLUE",
                          "RED",
                          "BLOCKED",
                          "STOPPED",
                          "COMPLETE"
                      ],
    "legacy_status_aliases":  {
                                  "WAITING_FOR_EXTERNAL_DEPENDENCY":  "BLUE"
                              }
}
